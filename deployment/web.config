<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      Production IIS hosting for Node.js via iisnode.
      Prereqs:
      - Install iisnode module
      - Install URL Rewrite module
      - Configure an HTTPS binding + certificate on the site
    -->

    <handlers>
      <add name="iisnode" path="src\index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Force HTTPS -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Send all traffic to Node entrypoint -->
        <rule name="Node" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="src\index.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

    <iisnode
      nodeProcessCommandLine="%programfiles%\nodejs\node.exe"
      loggingEnabled="true"
      devErrorsEnabled="false"
      flushResponse="true"
      watchedFiles="web.config;src\\*.js;src\\**\\*.js;.env.production"
    />

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- Environment vars are configured on the IIS App Pool / Web Site (recommended).
       These are fallback defaults (do not store secrets here in real prod). -->
  <appSettings>
    <add key="NODE_ENV" value="production" />
    <add key="PORT" value="3000" />
  </appSettings>
</configuration>
